package views

import (
	"fmt"
	"odkrywajac/internal/templates/layout"
)

templ HomepageContent(stats layout.NavStats) {
	<section class="hero-section">
		<div id="hero-container"></div>
	</section>
	<section class="stats-section">
		@HomepageStats(stats)
	</section>
	<section class="posts-section">
		<div id="posts-grid"></div>
	</section>
	<section class="categories-section">
		<div id="category-chips"></div>
	</section>
}

templ HomepageStats(stats layout.NavStats) {
	<div class="stats-row">
		<span class="stat">
			{ fmt.Sprintf("%dkm", stats.BicycleDistance) }
		</span>
		<span class="stat">
			{ fmt.Sprintf("%dkm", stats.HikeDistance) }
		</span>
		<span class="stat">
			{ fmt.Sprintf("%dh", stats.SelfTime) }
		</span>
	</div>
}
