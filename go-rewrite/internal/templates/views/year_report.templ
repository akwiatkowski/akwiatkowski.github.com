package views

import "fmt"

templ YearReportContent(rd YearReportData) {
	<section class="section" style="padding-top: 40px;">
		<div class="container">
			<div class="row">
				<div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
					<h1>{ fmt.Sprintf("Rok %d", rd.Year) }</h1>

					<!-- Year navigation -->
					<div class="year-nav mb-4">
						for _, yl := range rd.YearReportURLs {
							if yl.IsCurrent {
								<strong class="me-2">{ fmt.Sprintf("%d", yl.Year) }</strong>
							} else {
								<a href={ templ.SafeURL(yl.URL) } class="me-2">{ fmt.Sprintf("%d", yl.Year) }</a>
							}
						}
					</div>

					<!-- Sparkline SVG -->
					<div class="sparkline-container mb-4">
						@yearSparkline(rd)
					</div>

					<!-- Photo of the year -->
					if rd.PhotoOfYearURL != "" {
						<div class="photo-of-year mb-4">
							<a href={ templ.SafeURL(rd.PhotoOfYearPostURL) }>
								<picture>
									<source srcset={ rd.PhotoOfYearAVIF } type="image/avif"/>
									<img src={ rd.PhotoOfYearURL } alt={ rd.PhotoOfYearTitle } class="img-fluid" loading="lazy"/>
								</picture>
								<div class="photo-of-year-badge">{ rd.PhotoOfYearTitle }</div>
							</a>
						</div>
					}

					<!-- Summary cards -->
					<div class="row g-3 mb-4">
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d", rd.PostCount) }</div>
								<div class="card-label">wpisów</div>
							</div>
						</div>
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d km", rd.TotalDistance) }</div>
								<div class="card-label">dystans</div>
							</div>
						</div>
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d h", rd.TotalTime) }</div>
								<div class="card-label">czas</div>
							</div>
						</div>
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d", rd.BicycleCount) }</div>
								<div class="card-label">rowerem</div>
							</div>
						</div>
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d", rd.HikeCount) }</div>
								<div class="card-label">pieszo</div>
							</div>
						</div>
						<div class="col-6 col-md-4">
							<div class="card text-center p-3">
								<div class="card-value">{ fmt.Sprintf("%d", rd.NewTownsCount) }</div>
								<div class="card-label">nowe gminy</div>
							</div>
						</div>
					</div>

					<!-- Year-over-year comparison -->
					if rd.PrevYearDistance > 0 {
						<p class="text-muted mb-4">
							{ fmt.Sprintf("Rok wcześniej: %d km, %d h. ", rd.PrevYearDistance, rd.PrevYearTime) }
							if rd.TotalDistance > rd.PrevYearDistance {
								{ fmt.Sprintf("Zmiana: +%d km", rd.TotalDistance - rd.PrevYearDistance) }
							} else {
								{ fmt.Sprintf("Zmiana: %d km", rd.TotalDistance - rd.PrevYearDistance) }
							}
						</p>
					}

					<!-- Tag breakdown -->
					if len(rd.TagBreakdown) > 0 {
						<div class="tag-chips mb-4">
							for _, tc := range rd.TagBreakdown {
								<span class="badge bg-secondary me-1 mb-1">
									{ tc.Name }
									<span class="badge bg-light text-dark ms-1">{ fmt.Sprintf("%d", tc.Count) }</span>
								</span>
							}
						</div>
					}

					<!-- Voivodeships -->
					if len(rd.Voivodeships) > 0 {
						<div class="mb-4">
							<strong>Województwa: </strong>
							for i, v := range rd.Voivodeships {
								if i > 0 {
									{ ", " }
								}
								<a href={ templ.SafeURL(v.URL) }>{ v.Name }</a>
							}
						</div>
					}

					<!-- Records -->
					<div class="row g-3 mb-4">
						if rd.LongestTrip > 0 {
							<div class="col-md-4">
								if rd.IsLongestAllTime {
									<div class="card border-success p-3">
										<div class="card-body">
											<strong>Rekord!</strong>
											<div>Najdłuższa trasa: { fmt.Sprintf("%.0f km", rd.LongestTrip) }</div>
											<a href={ templ.SafeURL(rd.LongestTripURL) }>{ rd.LongestTripTitle }</a>
										</div>
									</div>
								} else {
									<div class="card p-3">
										<div class="card-body">
											<div>Najdłuższa trasa: { fmt.Sprintf("%.0f km", rd.LongestTrip) }</div>
											<a href={ templ.SafeURL(rd.LongestTripURL) }>{ rd.LongestTripTitle }</a>
										</div>
									</div>
								}
							</div>
						}
						if rd.MostActiveMonth != "" {
							<div class="col-md-4">
								if rd.IsMostActiveAllTime {
									<div class="card border-success p-3">
										<div class="card-body">
											<strong>Rekord!</strong>
											<div>Najbardziej aktywny miesiąc</div>
											<div>{ fmt.Sprintf("%s: %.0f km", rd.MostActiveMonth, rd.MostActiveMonthDist) }</div>
										</div>
									</div>
								} else {
									<div class="card p-3">
										<div class="card-body">
											<div>Najbardziej aktywny miesiąc</div>
											<div>{ fmt.Sprintf("%s: %.0f km", rd.MostActiveMonth, rd.MostActiveMonthDist) }</div>
										</div>
									</div>
								}
							</div>
						}
						<div class="col-md-4">
							if rd.IsPostRecordYear {
								<div class="card border-success p-3">
									<div class="card-body">
										<strong>Rekord!</strong>
										<div>Najwięcej wpisów</div>
										<div>{ fmt.Sprintf("%d wpisów", rd.PostCount) }</div>
									</div>
								</div>
							} else {
								<div class="card p-3">
									<div class="card-body">
										<div>Najwięcej wpisów</div>
										<div>{ fmt.Sprintf("Rekord: %d (%d)", rd.MostPostsCount, rd.MostPostsYear) }</div>
									</div>
								</div>
							}
						</div>
					</div>

					<!-- Route map -->
					if rd.HasRoutes {
						<div id="year-map" style="height: 400px; margin-bottom: 20px;"></div>
						<script id="year-routes" type="application/json">
							@templ.Raw(rd.RouteJSON)
						</script>
					}

					<!-- Posts table -->
					if len(rd.Posts) > 0 {
						<h3 class="ys-section-title">Wpisy</h3>
						<div class="table-responsive">
							<table class="table table-sm">
								<thead>
									<tr>
										<th>Data</th>
										<th>Tytuł</th>
										<th class="text-end">km</th>
										<th class="text-end">h</th>
										<th class="text-center"></th>
									</tr>
								</thead>
								<tbody>
									for _, entry := range rd.Posts {
										<tr>
											<td class="text-nowrap"><a href={ templ.SafeURL(entry.URL) }>{ entry.Date }</a></td>
											<td><a href={ templ.SafeURL(entry.URL) }>{ entry.Title }</a></td>
											<td class="text-end">{ fmt.Sprintf("%d", entry.Distance) }</td>
											<td class="text-end">{ fmt.Sprintf("%d", entry.Time) }</td>
											<td class="text-center">
												if entry.Icon != "" {
													<span class={ entry.Icon }></span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}

					<!-- Monthly breakdown table -->
					<h3 class="ys-section-title">Miesiące</h3>
					<div class="table-responsive">
						<table class="table table-sm">
							<thead>
								<tr>
									<th>Miesiąc</th>
									<th>Dystans</th>
									<th>Rower</th>
									<th>Pieszo</th>
									<th>Czas</th>
									<th>Wpisy</th>
								</tr>
							</thead>
							<tbody>
								for i := 0; i < 12; i++ {
									if rd.Months[i].PostCount > 0 {
										<tr>
											<td>{ monthNamePl(i + 1) }</td>
											<td>{ fmt.Sprintf("%.0f km", rd.Months[i].Distance) }</td>
											<td>{ fmt.Sprintf("%.0f km", rd.Months[i].BicycleDistance) }</td>
											<td>{ fmt.Sprintf("%.0f km", rd.Months[i].HikeDistance) }</td>
											<td>{ fmt.Sprintf("%.0f h", rd.Months[i].TimeSpent) }</td>
											<td>{ fmt.Sprintf("%d", rd.Months[i].PostCount) }</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ yearSparkline(rd YearReportData) {
	if rd.MaxMonthDist > 0 {
		<svg viewBox="0 0 240 60" class="sparkline" xmlns="http://www.w3.org/2000/svg">
			<path d={ sparklinePath(rd, true) } fill="rgba(51,136,255,0.2)" stroke="none"/>
			<path d={ sparklinePath(rd, false) } fill="none" stroke="#3388ff" stroke-width="2"/>
			for i := 0; i < 12; i++ {
				<circle cx={ fmt.Sprintf("%.1f", float64(i)*20+10) } cy={ fmt.Sprintf("%.1f", 55-rd.Months[i].Distance/rd.MaxMonthDist*50) } r="3" fill="#3388ff"/>
			}
		</svg>
	}
}

func sparklinePath(rd YearReportData, closed bool) string {
	if rd.MaxMonthDist == 0 {
		return ""
	}
	path := ""
	for i := 0; i < 12; i++ {
		x := float64(i)*20 + 10
		y := 55 - rd.Months[i].Distance/rd.MaxMonthDist*50
		if i == 0 {
			path += fmt.Sprintf("M%.1f,%.1f", x, y)
		} else {
			path += fmt.Sprintf(" L%.1f,%.1f", x, y)
		}
	}
	if closed {
		path += fmt.Sprintf(" L%.1f,55 L10,55 Z", float64(11)*20+10)
	}
	return path
}

func monthNamePl(m int) string {
	names := [12]string{
		"Styczeń", "Luty", "Marzec", "Kwiecień", "Maj", "Czerwiec",
		"Lipiec", "Sierpień", "Wrzesień", "Październik", "Listopad", "Grudzień",
	}
	if m >= 1 && m <= 12 {
		return names[m-1]
	}
	return ""
}
