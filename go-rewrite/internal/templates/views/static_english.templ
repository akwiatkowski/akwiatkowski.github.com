package views

templ StaticEnglishContent(renderedHTML string) {
	<header class="intro-header">
		<div class="container">
			<div class="row">
				<div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
					<div class="post-heading">
						<h1>Welcome</h1>
						<h2 class="subheading">a few words for English only speaking visitors</h2>
					</div>
				</div>
			</div>
		</div>
	</header>
	<article>
		<div class="container">
			<div class="row">
				<div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
					@templ.Raw(renderedHTML)
				</div>
			</div>
		</div>
	</article>
	<hr/>
}
