package views

// ShellExifStatsContent renders the HTML structure expected by exif_stats.js.
// The JS fetches /jsons/photos.json and creates 25+ Chart.js charts analyzing
// EXIF metadata (focal length, aperture, ISO, cameras, lenses, shooting patterns).
// Chart.js and the matrix plugin are loaded from CDN.
templ ShellExifStatsContent() {
	<div class="exif-page">
		<header>
			<h1>Statystyka zdjęć</h1>
			<p class="header-subtitle">Analiza ewolucji stylu fotografii</p>
		</header>
		<div class="error-message" id="errorMessage"></div>
		<div class="mock-indicator" id="mockIndicator" style="display: none;">
			Dane testowe (10 rekordów). Włącz /jsons/photos.json aby zobaczyć pełne statystyki.
		</div>
		<!-- Progress Bar -->
		<div class="es-progress" id="progressContainer">
			<div class="es-progress-bar">
				<div class="es-progress-fill" id="progressFill" style="width: 0%"></div>
			</div>
			<div class="es-progress-text">
				Ładowanie zdjęć... <span id="progressText">0%</span>
			</div>
		</div>
		<!-- Filters -->
		<div class="controls">
			<div class="control-group">
				<label for="yearFilter">Rok:</label>
				<select id="yearFilter"><option value="">Wszystkie</option></select>
			</div>
			<div class="control-group">
				<label for="cameraFilter">Aparat:</label>
				<select id="cameraFilter"><option value="">Wszystkie</option></select>
			</div>
			<div class="control-group">
				<label for="lensFilter">Obiektyw:</label>
				<select id="lensFilter"><option value="">Wszystkie</option></select>
			</div>
			<div class="control-group">
				<label><input type="checkbox" id="includeNonInterchangeable"/> Aparaty bez zmiennej optyki</label>
			</div>
			<button onclick="resetFilters()">Resetuj filtry</button>
			<button onclick="downloadStats()" id="csvButton" style="display:none">Pobierz CSV</button>
		</div>
		<!-- Stat Cards -->
		<div class="stats-grid" id="statsGrid">
			<div class="stat-card">
				<div class="stat-label">Wszystkie zdjęcia</div>
				<div class="stat-value" id="totalPhotos">0</div>
				<div class="stat-detail" id="publishedCount">0 opublikowanych</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Ulubiona ogniskowa</div>
				<div class="stat-value" id="modalFocal">&mdash;</div>
				<div class="stat-detail" id="focalStats">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Średnia przysłona</div>
				<div class="stat-value" id="avgAperture">&mdash;</div>
				<div class="stat-detail" id="apertureStats">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Najczęstszy obiektyw</div>
				<div class="stat-value" id="topLens">&mdash;</div>
				<div class="stat-detail" id="lensStats">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Najczęstszy aparat</div>
				<div class="stat-value" id="topCamera">&mdash;</div>
				<div class="stat-detail" id="cameraStats">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Najczęstsze ISO</div>
				<div class="stat-value" id="avgISO">&mdash;</div>
				<div class="stat-detail" id="isoStats">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Wycieczki fotograficzne</div>
				<div class="stat-value" id="totalTrips">&mdash;</div>
				<div class="stat-detail" id="tripsDetail">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Aparaty / Obiektywy</div>
				<div class="stat-value" id="equipmentCount">&mdash;</div>
				<div class="stat-detail" id="equipmentDetail">Obliczanie...</div>
			</div>
			<div class="stat-card">
				<div class="stat-label">Godziny aktywności</div>
				<div class="stat-value" id="activeHours">&mdash;</div>
				<div class="stat-detail" id="activeHoursDetail">Obliczanie...</div>
			</div>
		</div>
		<!-- Section: Photos Over Time -->
		<h2 class="section-title">Zdjęcia w czasie</h2>
		<div class="charts-grid">
			<div class="chart-container">
				<div class="chart-title">Zdjęcia na rok</div>
				<canvas id="yearChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Wskaźnik publikacji na rok</div>
				<canvas id="publishedRatioChart"></canvas>
			</div>
		</div>
		<!-- Section: Equipment -->
		<h2 class="section-title">Sprzęt fotograficzny</h2>
		<div class="charts-grid">
			<div class="chart-container full-width tall">
				<div class="chart-title">Okres użytkowania sprzętu</div>
				<canvas id="equipmentLifespanChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Oś czasu aparatów (% rocznie)</div>
				<canvas id="cameraTimelineChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Top 10 aparatów</div>
				<canvas id="cameraChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Top 10 obiektywów</div>
				<canvas id="lensChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Użycie max przysłony na obiektyw</div>
				<canvas id="wideOpenChart"></canvas>
			</div>
		</div>
		<!-- Section: Focal Length -->
		<h2 class="section-title">Ogniskowa</h2>
		<div class="charts-grid">
			<div class="chart-container">
				<div class="chart-title">Rozkład ogniskowej</div>
				<canvas id="focalChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Proporcje: szeroki kąt vs tele w czasie</div>
				<canvas id="wideTeleChart"></canvas>
			</div>
			<div class="chart-container full-width">
				<div class="chart-title">Ulubione ogniskowe na obiektyw zoom</div>
				<canvas id="zoomSweetSpotChart"></canvas>
			</div>
			<div class="chart-container full-width">
				<div class="chart-title">Ewolucja ogniskowej (średnia i mediana na kwartał)</div>
				<canvas id="focalTimelineChart"></canvas>
			</div>
		</div>
		<!-- Section: Exposure -->
		<h2 class="section-title">Ustawienia ekspozycji</h2>
		<div class="charts-grid">
			<div class="chart-container">
				<div class="chart-title">Rozkład przysłony</div>
				<canvas id="apertureChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Rozkład ISO</div>
				<canvas id="isoChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Trend ISO w czasie (mediana na rok)</div>
				<canvas id="isoTrendChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Rozkład czasu ekspozycji</div>
				<canvas id="exposureChart"></canvas>
			</div>
		</div>
		<!-- Section: Shooting Patterns -->
		<h2 class="section-title">Wzorce fotografowania</h2>
		<div class="charts-grid">
			<div class="chart-container">
				<div class="chart-title">Pora dnia</div>
				<canvas id="hourChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Dzień tygodnia</div>
				<canvas id="dayOfWeekChart"></canvas>
			</div>
			<div class="chart-container full-width tall">
				<div class="chart-title">Pora dnia × miesiąc</div>
				<canvas id="hourMonthChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Interwały między zdjęciami</div>
				<canvas id="intervalChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Liczba zdjęć na wycieczkę</div>
				<canvas id="photosPerTripChart"></canvas>
			</div>
		</div>
		<!-- Section: Geography & Topics -->
		<h2 class="section-title">Teren i tematyka</h2>
		<div class="charts-grid">
			<div class="chart-container">
				<div class="chart-title">Rozkład wysokości n.p.m.</div>
				<canvas id="altitudeChart"></canvas>
			</div>
			<div class="chart-container">
				<div class="chart-title">Top 20 tagów</div>
				<canvas id="tagsChart"></canvas>
			</div>
		</div>
	</div>
}
