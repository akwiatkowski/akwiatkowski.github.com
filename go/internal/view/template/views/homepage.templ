package views

import (
	"fmt"
	"odkrywajac/internal/view/template/layout"
)

templ HomepageContent(stats layout.NavStats, coverageMapURL string) {
	<div class="home-page">
		<!-- Hero -->
		<section class="hero">
			<div class="hero-content">
				<div class="hero-text">
					<h1>
						Polska, której nie zobaczysz
						<span>z autostrady</span>
					</h1>
					<p>
						Boczne drogi. Ciche wsie. Zapomniane krajobrazy.
					</p>
					<div class="hero-stats">
						@HomepageStats(stats)
					</div>
				</div>
				<a href="#" class="hero-image hero-loading">
					<div class="hero-placeholder"></div>
					<img src="" alt="" style="display: none;"/>
					<div class="hero-image-caption">
						<h3></h3>
						<p></p>
					</div>
				</a>
			</div>
		</section>
		<!-- Recent posts -->
		<section class="section">
			<div class="section-header">
				<h2 class="section-title">Ostatnie wpisy</h2>
				<a href="/galeria.html" class="section-link">Zobacz wszystkie →</a>
			</div>
			<div class="posts-grid">
			<div class="loading-state">Wczytywanie wpisów...</div>
		</div>
		</section>
		<!-- Coverage map: visited powiaty, baked SVG (see view.CoverageMapSVG) -->
		<section class="section section-coverage">
			<div class="section-header">
				<h2 class="section-title">Gdzie już byłem</h2>
				<a href={ templ.SafeURL(stats.Links.MapURL) } class="section-link">Mapa tras →</a>
			</div>
			<div class="coverage">
				<a href={ templ.SafeURL(stats.Links.MapURL) } class="coverage-map">
					<img src={ coverageMapURL } alt="Mapa Polski z zaznaczonymi odwiedzonymi powiatami" loading="lazy" decoding="async"/>
				</a>
				<div class="coverage-text">
					<p class="coverage-count">
						<strong>{ formatThousands(stats.CountyCount) }</strong>
						{ fmt.Sprintf("z %d powiatów", stats.CountyTotal) }
					</p>
					<p class="coverage-desc">
						Każda wycieczka odsłania kolejny kawałek mapy. Im ciemniejszy
						powiat, tym dokładniej go poznałem — pieszo, rowerem i z aparatem.
						Jasne obszary wciąż czekają na odkrycie.
					</p>
				</div>
			</div>
		</section>
		<!-- Categories / Explore -->
		<section class="section-categories">
			<div class="section-categories-inner">
				<div class="section-header">
					<h2 class="section-title">Odkrywaj</h2>
				</div>
				<div class="categories"></div>
			</div>
		</section>
	</div>
}

templ HomepageStats(stats layout.NavStats) {
	<div class="stat">
		<span class="stat-value">
			{ fmt.Sprintf("%d", stats.BicycleDistance) }
			<span class="stat-unit">km</span>
		</span>
		<span class="stat-label">rowerem</span>
	</div>
	<div class="stat">
		<span class="stat-value">
			{ fmt.Sprintf("%d", stats.HikeDistance) }
			<span class="stat-unit">km</span>
		</span>
		<span class="stat-label">pieszo</span>
	</div>
	<div class="stat">
		<span class="stat-value">
			{ fmt.Sprintf("%d", stats.SelfTime) }
			<span class="stat-unit">h</span>
		</span>
		<span class="stat-label">w terenie</span>
	</div>
	<div class="stat">
		<span class="stat-value">{ formatThousands(stats.PostCount) }</span>
		<span class="stat-label">wpisów</span>
	</div>
	<div class="stat">
		<span class="stat-value">{ formatThousands(stats.PhotoCount) }</span>
		<span class="stat-label">zdjęć</span>
	</div>
	<div class="stat">
		<span class="stat-value">{ formatThousands(stats.CountyCount) }</span>
		<span class="stat-label">powiatów</span>
	</div>
}
