package views

import (
	"fmt"
)

// PostArticleData holds all data needed to render a post article page.
type PostArticleData struct {
	// Hero header
	HeroImageURL   string // full-size background image URL
	ImagePosition  string // CSS background-position (e.g. "50% 70%"), default "center center"
	Title          string
	Subtitle       string
	DateStr        string // formatted date (e.g. "2022-12-18 (niedziela)")
	Author         string

	// Rendered markdown HTML (with photo figures already embedded)
	RenderedMarkdown string

	// NotReady is set for release builds of a not-ready (todo) draft: the body
	// is withheld and a "not finished yet" notice is shown instead.
	NotReady bool

	// MarkdownURL is the absolute URL of this post's clean-CommonMark version.
	// Rendered as a visually-hidden pointer so a model receiving the page text
	// (someone pasting the URL into an AI chat) can fetch the clean version
	// instead of parsing the full page. Empty when no .md was generated.
	MarkdownURL string

	// Links
	TagLinks  []PostTagLink
	AreaLinks []PostAreaGroup

	// Navigation
	PrevPost *PostPagerData
	NextPost *PostPagerData

	// Related posts
	RelatedPosts []RelatedPostData

	// Route stats
	ActivityBadge string // e.g. "🥾 pieszo", "🚲 rowerem"
	DistanceStr   string // e.g. "15 km"
	TimeStr       string // e.g. "7 h"
	TemperatureStr string // e.g. "-8 °C"

	// SVG map (embedded route/photo map for posts with routes)
	SvgMapURL     string // e.g. "/mapa_zdjec/wpis/{slug}.svg"
	MapLinks      []MapLink // external map links (UMP, OSM, Mapy.cz, Google)

	// Post metadata
	GalleryURL    string
	FinishedAtStr string // formatted finished_at date, or ""
}

// MapLink represents an external map service link.
type MapLink struct {
	Name string // e.g. "OSM", "Google"
	URL  string
}

// PostTagLink is a tag link shown at the top of the article.
type PostTagLink struct {
	URL  string
	Name string
}

// PostAreaGroup groups area links by type (e.g., "Gminy:", "Województwa:").
type PostAreaGroup struct {
	Label string // e.g., "Gminy"
	Areas []PostAreaLink
}

// PostAreaLink is a single area link.
type PostAreaLink struct {
	URL  string
	Name string
}

// PostPagerData holds data for the prev/next post pager.
type PostPagerData struct {
	URL              string
	Title            string
	ThumbnailJPEGURL string // 150×112 JPEG
	ThumbnailAVIFURL string // 150×112 AVIF
}

// RelatedPostData holds data for one card in the "Powiązane wpisy" grid.
// Mirrors Crystal's data/layout/post/related_post.html placeholders.
type RelatedPostData struct {
	URL         string
	Title       string
	Date        string // formatted post date, e.g. "2021-08-27"
	GridJPEGURL string // 560×420 JPEG
	GridAVIFURL string // 560×420 AVIF
}

// heroStyle returns the CSS for the hero header background.
func heroStyle(imageURL, position string) string {
	if position == "" {
		position = "center center"
	}
	return fmt.Sprintf("background-image: url('%s'); background-position: %s", imageURL, position)
}

templ HeroHeader(data PostArticleData) {
	<header class="intro-header" { templ.Attributes{"style": heroStyle(data.HeroImageURL, data.ImagePosition)}... }>
		<div class="site-content">
			<div class="post-heading">
				<h1>{ data.Title }</h1>
				if data.Subtitle != "" {
					<h2 class="subheading">{ data.Subtitle }</h2>
				}
				<span class="meta">{ data.Author }, { data.DateStr }</span>
			</div>
		</div>
	</header>
}

templ PostArticleContent(data PostArticleData) {
	if data.MarkdownURL != "" {
		// aria-hidden as well as visually hidden: this is a machine-readable
		// hint, not content, and a screen reader announcing it would be noise.
		<div class="visually-hidden" aria-hidden="true">
			{ fmt.Sprintf("A Markdown version of this page is available at %s", data.MarkdownURL) }
		</div>
	}
	if data.HeroImageURL != "" {
		@HeroHeader(data)
	}
	<article class="site-content">
		if len(data.TagLinks) > 0 || len(data.AreaLinks) > 0 {
			<div class="post-meta-block">
				if len(data.TagLinks) > 0 {
					<div class="post-meta-row">
						<span class="post-meta-label">Tagi</span>
						<span class="post-meta-links">
							for i, tag := range data.TagLinks {
								if i > 0 {
									{ ", " }
								}
								<a href={ templ.SafeURL(tag.URL) }>{ tag.Name }</a>
							}
						</span>
					</div>
				}
				for _, group := range data.AreaLinks {
					<div class="post-meta-row">
						<span class="post-meta-label">{ group.Label }</span>
						<span class="post-meta-links">
							for i, area := range group.Areas {
								if i > 0 {
									{ ", " }
								}
								<a href={ templ.SafeURL(area.URL) }>{ area.Name }</a>
							}
						</span>
					</div>
				}
			</div>
		}
		if data.SvgMapURL != "" {
			<h2>Mapa</h2>
			<object class="post_small_photo_map" style="max-width:100%;" data={ data.SvgMapURL } alt="Mapa"></object>
		}
		if data.DistanceStr != "" || data.TimeStr != "" || len(data.MapLinks) > 0 {
			<div class="post-map-footer">
				if data.DistanceStr != "" || data.TimeStr != "" {
					<div class="post-route-stats">
						if data.ActivityBadge != "" {
							<span class="activity-badge">{ data.ActivityBadge }</span>
						}
						if data.DistanceStr != "" {
							<span>{ "📍 " + data.DistanceStr }</span>
						}
						if data.TimeStr != "" {
							<span>{ "⏱️ " + data.TimeStr }</span>
						}
						if data.TemperatureStr != "" {
							<span>{ data.TemperatureStr }</span>
						}
					</div>
				}
				if len(data.MapLinks) > 0 {
					<span class="post-map-links">
						<span class="post-map-links-label">Mapy:</span>
						for _, link := range data.MapLinks {
							<a href={ templ.SafeURL(link.URL) } target="_blank">{ link.Name }</a>
						}
					</span>
				}
			</div>
		}
		<div class="post-content">
			if data.NotReady {
				@NotReadyNotice()
			} else {
				@templ.Raw(data.RenderedMarkdown)
			}
		</div>
		if data.FinishedAtStr != "" {
			<p class="finished-at">
				{ fmt.Sprintf("Wpis ukończony: %s", data.FinishedAtStr) }
			</p>
		}
		if len(data.RelatedPosts) > 0 {
			<section class="related-posts">
				<h2 class="post-section-label">Powiązane wpisy</h2>
				<div class="related-posts-grid">
					for _, rp := range data.RelatedPosts {
						@RelatedPostCard(rp)
					}
				</div>
			</section>
		}
		<div class="post-pager-container">
			if data.PrevPost != nil {
				@PostPagerLink(*data.PrevPost, "post-pager-prev", "← Poprzedni")
			}
			if data.GalleryURL != "" {
				<a class="post-pager-gallery-btn" href={ templ.SafeURL(data.GalleryURL) } data-bs-toggle="tooltip" data-bs-placement="top" title="Galeria">Galeria</a>
			}
			if data.NextPost != nil {
				@PostPagerLink(*data.NextPost, "post-pager-next", "Następny →")
			}
		</div>
	</article>
}

// NotReadyNotice is the "post not finished yet" warning shown in place of the
// body for release builds of a not-ready (todo) draft. Mirrors Crystal's
// data/layout/post/todo.html.
templ NotReadyNotice() {
	<div class="alert alert-warning">
		<strong>
			Nie przestrasz się, proszę! Wpis nie został jeszcze dokończony.
		</strong>
		<p>Procedura tworzenia wpisów wygląda następująco:</p>
		<ol>
			<li>Bycie w terenie - czyli aktywność która zostanie opisana,</li>
			<li>Utworzenie pustego wpisu - zdjęcie, trasa, informacje o kilometrach, gminach, ...</li>
			<li>Notatki - strzępki ulotnych informacji w formie listy</li>
			<li>Tekst wstępny</li>
			<li>Poprawki w tekście</li>
			<li>Media - głównie zdjęcia, czasem filmik</li>
		</ol>
		<p>
			Widzisz to, ponieważ niestety jeszcze nie miałem czasu aby napisać
			i poprawić tekst wpisu. Będę to robił stopniowo gdy pogoda nie będzie
			sprzyjać wyjazdom. Tymczasem zapraszam na ukończone wpisy na
			<a href="/"><strong>stronie głównej</strong></a>.
		</p>
	</div>
}

templ PostPagerLink(pager PostPagerData, cssClass string, label string) {
	<a href={ templ.SafeURL(pager.URL) } class={ "post-pager", cssClass }>
		if cssClass == "post-pager-prev" && pager.ThumbnailJPEGURL != "" {
			@PostPagerPicture(pager)
		}
		<div class="post-pager-text">
			<span class="post-pager-label">{ label }</span>
			<span class="post-pager-title">{ pager.Title }</span>
		</div>
		if cssClass == "post-pager-next" && pager.ThumbnailJPEGURL != "" {
			@PostPagerPicture(pager)
		}
	</a>
}

// RelatedPostCard renders one card in the related-posts grid. Markup mirrors
// Crystal's data/layout/post/related_post.html so both engines share the
// .related-post-card styles in new.css.
templ RelatedPostCard(related RelatedPostData) {
	<a href={ templ.SafeURL(related.URL) } class="related-post-card">
		if related.GridJPEGURL != "" {
			<picture>
				if related.GridAVIFURL != "" {
					<source type="image/avif" srcset={ related.GridAVIFURL }/>
				}
				<img src={ related.GridJPEGURL } alt="" loading="lazy"/>
			</picture>
		}
		<span class="related-post-date">{ related.Date }</span>
		<span class="related-post-title">{ related.Title }</span>
	</a>
}

templ PostPagerPicture(pager PostPagerData) {
	<picture>
		if pager.ThumbnailAVIFURL != "" {
			<source type="image/avif" srcset={ pager.ThumbnailAVIFURL }/>
		}
		<img src={ pager.ThumbnailJPEGURL } alt="" loading="lazy"/>
	</picture>
}
