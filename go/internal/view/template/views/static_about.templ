package views

templ StaticAboutContent(renderedHTML string) {
	<header class="intro-header">
		<div class="site-content">
			<div class="post-heading">
				<h1>O mnie</h1>
				<h2 class="subheading">I o tej stronie</h2>
			</div>
		</div>
	</header>
	<article class="site-content">
		@templ.Raw(renderedHTML)
	</article>
	<hr/>
}
